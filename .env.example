# URL base do backend (sem barra no final). Ex.: http://localhost:3000
#   - vazia: modo demonstração (sem backend, dados no navegador)
#   - "/": mesma origem do front (use com API_PROXY_TARGET em desenvolvimento)
VITE_API_URL=

# Só para `npm run dev` e `npm run preview`: encaminha /api para o backend e evita CORS.
# Exemplo: VITE_API_URL=/ e API_PROXY_TARGET=http://localhost:3000
API_PROXY_TARGET=
