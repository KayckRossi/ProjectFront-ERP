# Copie para .env.local e ajuste.

# Endereço do backend. Vazio = modo demonstração (dados de exemplo no navegador).
# "/" = mesma origem do front (use com API_PROXY_TARGET para evitar CORS).
# Também dá para trocar sem rebuild abrindo o front com ?api=https://sua-api (e ?api=demo para voltar).
VITE_API_URL=

# Só dev/preview: com VITE_API_URL=/, o Vite repassa /api para este endereço.
API_PROXY_TARGET=

# Só dev/preview: repassa /admin para o backoffice (rodando com BASE_PATH=/admin/), para servir os dois apps no mesmo link.
# Ex.: BACKOFFICE_PROXY_TARGET=http://localhost:4174
BACKOFFICE_PROXY_TARGET=
